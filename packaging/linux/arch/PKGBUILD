# Maintainer: Mulletware
pkgname=qmkonnect
pkgver=0.2.8
pkgrel=1
pkgdesc="A notification daemon for QMK keyboards"
arch=('x86_64')
url="https://github.com/dabstractor/qmkonnect"
license=('MIT')
depends=('systemd' 'hidapi' 'libusb' 'zenity' 'libnotify')
makedepends=('cargo' 'rust' 'libx11' 'libxcb' 'systemd-libs' 'pkg-config')
# Only the (optional, user-instantiated) service template is preserved across
# upgrades. The static udev rule and helper are package-owned and removed
# automatically on uninstall; the on-demand /etc/.../99-qmkonnect.rules is
# generated by the user, not shipped.
backup=("usr/lib/systemd/user/qmkonnect.service.template")
install=qmkonnect.install
options=(!strip)

build() {
  cd "$srcdir/.."

  # A plain release build is the full app (Hyprland monitor + SNI tray). Link
  # against hidapi-hidraw (not hidapi-libusb) so usage / usage_page matching
  # works. This also builds the qmkonnect-hid-id udev helper (pure-std bin).
  RUSTFLAGS="-C link-arg=-lhidapi-hidraw" cargo build --release
}

package() {
  cd "$srcdir/.."

  # Main binary.
  install -Dm755 "../../../target/release/qmkonnect" "$pkgdir/usr/bin/qmkonnect"

  # udev helper: tags any hidraw interface exposing the QMK Raw HID signature
  # (usage page 0xFF60 / usage 0x61) so the static rule can grant permissions
  # uniformly — no per-VID/PID config, no --reload, no sudo for default users.
  install -Dm755 "../../../target/release/qmkonnect-hid-id" "$pkgdir/usr/lib/udev/qmkonnect-hid-id"

  # Static udev rule: IDENTICAL for every keyboard, never regenerated from
  # config. Numbered 69 so it runs before any on-demand 99-qmkonnect.rules the
  # user may generate with `qmkonnect -r`.
  install -Dm644 "../udev/69-qmkonnect-rawhid.rules" "$pkgdir/usr/lib/udev/rules.d/69-qmkonnect-rawhid.rules"

  # systemd user service template (post_install instantiates it). No VID/PID is
  # substituted: the service binds to the qmkonnect_device symlink that the
  # static rule creates for any matched interface.
  install -Dm644 "../systemd/qmkonnect.service.template" "$pkgdir/usr/lib/systemd/user/qmkonnect.service.template"
}
