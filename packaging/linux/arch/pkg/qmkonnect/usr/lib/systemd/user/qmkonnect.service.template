[Unit]
Description=QMKonnect - QMK Keyboard Window Notifier
After=graphical-session.target

# This handles the device dependency correctly:
# 1. At boot, it waits for the keyboard to be ready.
# 2. On unplug, it stops the service.
BindsTo=dev-qmkonnect_device.device

# Limit restart attempts to prevent infinite restart loops
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple

ExecStart=/usr/bin/qmkonnect

# Crash recovery settings
Restart=always
RestartSec=5

# Environment settings
Environment=RUST_BACKTRACE=1

# Security settings (relaxed to allow access to user session)
PrivateTmp=false
ProtectSystem=full
ProtectHome=false
NoNewPrivileges=true

# Allow access to device files and user runtime directory
ReadWritePaths=/dev
ReadWritePaths=%t

[Install]
# Hook the service into the user login process.
WantedBy=default.target