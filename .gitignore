# Rust build output
/target

# Local agent/IDE scratch
.aider*
/.claude
/.kiro

# Build artifacts — never commit compiled output or installers
*.msi
*.wixpdb
*.wixobj
*.dmg
*.pkg.tar.*
*.AppImage

# Generated macOS app bundle (regenerated by packaging/macos/build.sh)
packaging/macos/QMKonnect.app/

# Inno Setup build output (regenerated by packaging/windows/inno/build.ps1)
packaging/windows/inno/Output/

# Arch package build output (regenerated by makepkg)
packaging/linux/arch/pkg/
packaging/linux/arch/src/
packaging/linux/arch/*.pkg.tar.*

# Generated docs site
docs/_site/

# macOS / editor cruft
.DS_Store
*.swp
/.envrc
